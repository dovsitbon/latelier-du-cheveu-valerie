---
import { SITE } from '../data/site';
---
<div class="carte relative min-w-0 w-full aspect-[4/3] lg:aspect-auto lg:h-full min-h-[300px] overflow-hidden bg-nude" data-carte>
  <svg class="absolute inset-0 w-full h-full" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <rect width="400" height="300" fill="#ebd5cc" />
    <path d="M-20 40 L 420 230" stroke="#faf6f1" stroke-width="26" fill="none" />
    <path d="M-20 40 L 420 230" stroke="#9c5530" stroke-opacity=".55" stroke-width="1.5" stroke-dasharray="7 5" fill="none" />
    <path d="M120 -10 L 70 320" stroke="#faf6f1" stroke-width="10" fill="none" />
    <path d="M330 -10 L 300 320" stroke="#faf6f1" stroke-width="8" fill="none" />
    <text x="250" y="166" font-family="Manrope Variable, sans-serif" font-size="12" fill="#1e2a44" transform="rotate(23.4 250 166)">rue de Paris</text>
    <circle cx="205" cy="128" r="13" fill="#1e2a44" /><circle cx="205" cy="128" r="4.5" fill="#faf6f1" />
  </svg>
  <p class="absolute left-3 top-3 bg-blanc px-3 py-1.5 text-[0.88rem]">{SITE.adresse.rue}, {SITE.adresse.cp} {SITE.adresse.ville}</p>
  <div class="absolute left-3 right-3 bottom-3 flex flex-wrap gap-2">
    <button type="button" class="btn btn-plein" data-charger-carte>Afficher la carte Google</button>
    <a href={SITE.itineraire} class="btn btn-ligne bg-blanc" target="_blank" rel="noopener">Itinéraire</a>
  </div>
</div>
<script>
  import { SITE } from '../data/site';
  document.querySelectorAll<HTMLElement>('[data-carte]').forEach((box) => {
    box.querySelector('[data-charger-carte]')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = SITE.carte;
      f.title = `Carte : ${SITE.nom}, ${SITE.adresse.rue}, ${SITE.adresse.ville}`;
      f.loading = 'lazy';
      f.referrerPolicy = 'no-referrer-when-downgrade';
      f.className = 'absolute inset-0 w-full h-full border-0';
      box.replaceChildren(f);
      f.focus();
    });
  });
</script>
