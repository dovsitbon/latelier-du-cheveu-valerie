---
import '../styles/global.css';
import Entete from '../components/Entete.astro';
import Pied from '../components/Pied.astro';
import BarreMobile from '../components/BarreMobile.astro';
import { SITE, HORAIRES } from '../data/site';

interface Props {
  title: string;
  description: string;
  jsonld?: object[];
  noindex?: boolean;
}
const { title, description, jsonld = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL('/og.png', Astro.site);
const DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

// Regroupe les jours ayant les mêmes plages (les jours « à confirmer » sont exclus).
const specs: Record<string, string[]> = {};
for (const h of HORAIRES) {
  if (h.aConfirmer) continue;
  for (const p of h.plages) (specs[`${p.ouvre}-${p.ferme}`] ??= []).push(DAYS[h.jour]);
}

const salon = {
  '@context': 'https://schema.org',
  '@type': 'HairSalon',
  '@id': new URL('/#salon', Astro.site).href,
  name: SITE.nom,
  legalName: SITE.societe,
  url: new URL('/', Astro.site).href,
  telephone: SITE.telLien,
  image: og.href,
  logo: new URL('/apple-touch-icon.png', Astro.site).href,
  slogan: 'La beauté dans chaque détail',
  description: `Salon de coiffure femme et homme à ${SITE.adresse.ville}, spécialiste de la couleur (balayage, ombré, patine, mèches, rattrapage de couleur). Avec ou sans rendez-vous.`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.adresse.rue,
    postalCode: SITE.adresse.cp,
    addressLocality: SITE.adresse.ville,
    addressRegion: SITE.adresse.region,
    addressCountry: SITE.adresse.pays,
  },
  areaServed: [SITE.adresse.ville, ...SITE.voisines].map((n) => ({ '@type': 'City', name: n })),
  openingHoursSpecification: Object.entries(specs).map(([k, d]) => {
    const [opens, closes] = k.split('-');
    return { '@type': 'OpeningHoursSpecification', dayOfWeek: d, opens, closes };
  }),
  aggregateRating: { '@type': 'AggregateRating', ratingValue: SITE.noteGoogleNum, bestRating: 5, reviewCount: SITE.nbAvisGoogle },
  amenityFeature: [
    { '@type': 'LocationFeatureSpecification', name: 'Entrée accessible en fauteuil roulant', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Parking accessible en fauteuil roulant', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Sans rendez-vous', value: true },
  ],
  paymentAccepted: 'Carte bancaire, paiement sans contact',
  potentialAction: { '@type': 'ReserveAction', target: SITE.planity },
  knowsAbout: ['Balayage', 'Ombré', 'Patine', 'Mèches', 'Coloration', 'Rattrapage de couleur', 'Coupe', 'Brushing', 'Lissage'],
  sameAs: [SITE.instagram, SITE.planity],
};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#faf6f1" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={SITE.nom} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.nom}, coiffure et couleur sur-mesure à ${SITE.adresse.ville}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(salon)} />
    {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </head>
  <body class="min-h-dvh flex flex-col">
    <a href="#contenu" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-blanc focus:px-4 focus:py-3 focus:font-semibold">Aller au contenu</a>
    <Entete />
    <main id="contenu" class="flex-1">
      <slot />
    </main>
    <Pied />
    <BarreMobile />
    <script is:inline define:vars={{ horaires: HORAIRES }}>
      (function () {
        try {
          var parts = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Paris', weekday: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(new Date());
          var get = function (t) { return (parts.find(function (p) { return p.type === t; }) || {}).value; };
          var j = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 }[get('weekday')];
          var min = parseInt(get('hour'), 10) * 60 + parseInt(get('minute'), 10);
          var toMin = function (h) { var a = h.split(':'); return +a[0] * 60 + +a[1]; };
          var fmt = function (h) { return h.replace(/^0/, '').replace(':', 'h'); };
          var jour = function (n) { return horaires.find(function (h) { return h.jour === n; }); };
          var auj = jour(j);
          var etat = 'non', texte;
          var enCours = auj.plages.find(function (p) { return min >= toMin(p.ouvre) && min < toMin(p.ferme); });
          var plusTard = auj.plages.find(function (p) { return min < toMin(p.ouvre); });
          if (auj.aConfirmer) { etat = 'inconnu'; texte = 'Lundi : ouverture à confirmer, appelez avant de venir'; }
          else if (enCours) { etat = 'oui'; texte = 'Ouvert maintenant, jusqu’à ' + fmt(enCours.ferme); }
          else if (plusTard) texte = 'Fermé, ouvre à ' + fmt(plusTard.ouvre);
          else {
            for (var i = 1; i <= 7; i++) {
              var d = jour((j + i) % 7);
              if (d.plages.length && !d.aConfirmer) { texte = 'Fermé, ouvre ' + (i === 1 ? 'demain' : d.nom.toLowerCase()) + ' à ' + fmt(d.plages[0].ouvre); break; }
            }
          }
          document.querySelectorAll('[data-statut]').forEach(function (el) {
            el.dataset.ouvert = etat;
            var t = el.querySelector('[data-statut-texte]');
            if (t && texte) t.textContent = texte;
          });
          document.querySelectorAll('[data-jour="' + j + '"]').forEach(function (el) { el.setAttribute('aria-current', 'date'); });
        } catch (e) {}
      })();
    </script>
  </body>
</html>
